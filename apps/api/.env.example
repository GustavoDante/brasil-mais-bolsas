ALLOWED_ORIGINS=""
PORT=3000

# Swagger em /docs. Fora de producao ele sobe sozinho; com NODE_ENV=production
# so aparece com "true" (util em homologacao).
SWAGGER_ENABLED=""

# Use this for local development with Docker
DATABASE_URL=""
# Use this for remote database
# DATABASE_URL=""

# Legacy database (old Sequelize API) — only used by scripts/legacy-migration
LEGACY_DATABASE_URL=""
# "true" forces SSL on the legacy connection (AWS RDS/Lightsail). Defaults to true for remote hosts.
LEGACY_DATABASE_SSL=""

JWT_SECRET=""
JWT_EXPIRES_IN=""

ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
ASAAS_BASE_URL=""

# --- Upload de arquivos (Amazon S3) ---
# Sem AWS_S3_BUCKET as rotas de upload respondem 503 "storage-not-configured"
AWS_S3_BUCKET=""
AWS_REGION="sa-east-1"
# Opcional: sem as chaves, o SDK usa a cadeia padrao da AWS (IAM role, ~/.aws/credentials)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Opcional: base publica do bucket/CDN (CloudFront). Vazio = URL padrao do S3
AWS_S3_PUBLIC_URL=""
# Opcional: endpoint compativel com S3 para desenvolvimento (MinIO/LocalStack)
AWS_S3_ENDPOINT=""

# --- E-mail transacional (Resend + React Email) ---
# Chave da API da Resend (https://resend.com/api-keys). Vazio = e-mails viram no-op logado
RESEND_API_KEY=""
# Remetente verificado na Resend, no formato "Nome <email@dominio>"
MAIL_FROM="Brasil Mais Bolsas <suporte@brasilmaisbolsas.com.br>"
# Opcional: para onde vão as respostas dos usuários
MAIL_REPLY_TO=""
# "false" desliga o envio sem remover a configuração (útil em homologação)
MAIL_ENABLED="true"

# Base do site usada para montar os links dos e-mails
APP_WEB_URL="https://brasilmaisbolsas.com.br"
# Opcionais: caminhos das páginas do site (usados nos botões dos e-mails)
MAIL_LOGIN_PATH="/login"
MAIL_PASSWORD_RESET_PATH="/resetar_senha"
MAIL_STUDENT_PORTAL_PATH="/portal-do-aluno"

# --- Contato com o suporte (POST /v1/contact) ---
# Caixa que recebe os contatos quando não há uma específica para a origem.
# Sem nenhuma destas configuradas, a rota responde 503 `contact-not-configured`.
CONTACT_EMAIL_DEFAULT="contato@brasilmaisbolsas.com.br"
# Opcionais: caixas por origem (`type` do payload). Vazio = cai na CONTACT_EMAIL_DEFAULT
CONTACT_EMAIL_SOU_ALUNO=""
CONTACT_EMAIL_QUERO_SER_ALUNO=""
CONTACT_EMAIL_SOU_PARCEIRO=""

# Validade do link de recuperação de senha, em horas
PASSWORD_RESET_TOKEN_TTL_HOURS="24"

# --- Tarefas agendadas (src/jobs) ---
# "false" desliga todos os agendamentos (a execução manual via /v1/jobs continua funcionando)
JOBS_ENABLED="true"
JOBS_TIMEZONE="America/Sao_Paulo"

# Renovação automática de pedidos (padrões herdados da API antiga)
ORDERS_RENEWAL_CRON="0 3 * * *"
ORDERS_RENEWAL_TRIGGER_DAYS="180"
# Janela de tolerância: recupera renovações de dias em que o job não rodou (0 = igual ao legado)
ORDERS_RENEWAL_GRACE_DAYS="7"
ORDERS_RENEWAL_PERCENT="30"
ORDERS_RENEWAL_MAX_INSTALLMENTS="4"
ORDERS_RENEWAL_DUE_DATE_LIMIT_DAYS="3"