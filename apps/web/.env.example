# Origem pública do site, sem barra final. É a base do canonical, do Open Graph,
# do sitemap.xml e do robots.txt — em produção precisa ser o domínio real.
NEXT_PUBLIC_SITE_URL="https://www.brasilmaisbolsas.com.br"

# URL da API (NestJS). O prefixo /v1 é adicionado pelo cliente HTTP.
NEXT_PUBLIC_API_URL="http://localhost:3333"

# "true" (padrão) = páginas usam os mocks de src/mocks; "false" = consome a API de verdade.
NEXT_PUBLIC_USE_MOCKS="true"

# Timeout de cada requisição, em milissegundos.
NEXT_PUBLIC_API_TIMEOUT_MS="15000"

# Revalidação (ISR) padrão dos dados públicos de catálogo, em segundos.
NEXT_PUBLIC_API_REVALIDATE="300"

# Base das imagens gravadas só com o nome do arquivo (uploads antigos da API legada).
# Registros novos já vêm com a URL completa do S3 e ignoram esta variável.
# Ex.: https://bucketbrasilmaisbolsas.s3.sa-east-1.amazonaws.com
NEXT_PUBLIC_IMAGES_BASE_URL=""
