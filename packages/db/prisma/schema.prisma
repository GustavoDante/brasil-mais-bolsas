generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Gera os schemas Zod dos models direto em `@repo/contracts`. É o que faz o
// `schema.prisma` ser a fonte única da FORMA das entidades nos dois apps — as regras de
// negócio ficam por conta da composição manual em contracts/src/<módulo>.
// Formato "wire" (DateTime -> string ISO): estes schemas descrevem o JSON que trafega
// no HTTP, não a linha do banco.
generator zod {
  provider = "prisma-zod-generator"
  output   = "../../contracts/src/generated"
  config   = "../zod-generator.config.json"
}

datasource db {
  provider = "postgresql"
}

enum DurationType {
  DAYS
  MONTHS
  YEARS
}

enum ScholarshipType {
  PRESENCIAL
  SEMI_PRESENCIAL
  EAD
}

enum PaymentType {
  BOLETO
  CREDIT_CARD
  PIX
  INTEREST
  REFUNDED
  CANCELLED
  UNDEFINED
}

enum PersonType {
  FISICA
  JURIDICA
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  password               String?
  reset_password_token   String?
  reset_password_expires DateTime?
  type                   String    @default("user")
  phone                  String
  secondary_phone        String?
  whatsapp_phone         String?
  friend_phone           String?
  birthdate              DateTime
  cpf                    String?
  rg                     String
  rg_emissor             String
  family_income          Decimal?  @db.Decimal(12, 2)
  ccp                    String?
  observations           String?   @db.Text
  partner_id             String?
  register_scholarship   String?
  institution_id         String?
  active                 Boolean   @default(true)
  delete                 Boolean   @default(false)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  address                      Address?
  client                       ExternalClient?
  partner                      Partner?              @relation(fields: [partner_id], references: [id], onDelete: SetNull)
  registerScholarship          Scholarship?          @relation("UserRegisterScholarship", fields: [register_scholarship], references: [id], onDelete: SetNull)
  institution                  Institution?          @relation("InstitutionManagerUsers", fields: [institution_id], references: [id], onDelete: SetNull)
  orders                       Order[]
  payments                     Payment[]
  notifications                Notification[]
  callsMade                    Call[]                @relation("UserCallsMade")
  callsReceived                Call[]                @relation("UserCallsReceived")
  indicationCallsMade          IndicationCall[]      @relation("IndicationCaller")
  indicationCallsReceived      IndicationCall[]      @relation("IndicationReceiver")
  possiblePartnerCallsMade     PossiblePartnerCall[] @relation("PossiblePartnerCaller")
  possiblePartnerCallsReceived PossiblePartnerCall[] @relation("PossiblePartnerReceiver")
  signedContracts              SignedContract[]
  indications                  Indication[]
  minors                       Minor[]
  identities                   UserIdentity[]

  @@index([partner_id])
  @@index([register_scholarship])
  @@index([institution_id])
}

model UserIdentity {
  id                  String   @id @default(cuid())
  user_id             String
  provider            String
  provider_account_id String
  email               String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@unique([provider, provider_account_id])
  @@unique([user_id, provider])
  @@index([user_id])
}

model Address {
  id          String   @id @default(cuid())
  user_id     String   @unique
  street      String
  city        String
  state       String
  number      String
  district    String
  complement  String?
  postal_code String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id])
}

model Partner {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  password   String   @default("123123")
  active     Boolean  @default(true)
  delete     Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users    User[]
  accesses Access[]
}

model Access {
  id         String   @id @default(cuid())
  partner_id String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  partner Partner @relation(fields: [partner_id], references: [id], onDelete: Restrict)

  @@index([partner_id])
}

model Seller {
  id         String   @id @default(cuid())
  name       String
  email      String
  password   String   @default("123123")
  active     Boolean  @default(true)
  delete     Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  institutions Institution[]
}

model Institution {
  id                    String    @id @default(cuid())
  name                  String
  description           String    @db.Text
  image                 String
  cnpj                  String
  email                 String?
  email_2               String?
  phone                 String
  phone_2               String?
  phone_3               String?
  owner_name            String
  owner_phone           String?
  owner_secondary_phone String?
  owner_birthdate       DateTime?
  operator_name         String
  operator_phone        String?
  operator_birthdate    DateTime?
  operator_2_name       String?
  operator_2_phone      String?
  operator_2_birthdate  DateTime?
  street                String
  number                String
  district              String
  city                  String
  state                 String
  postal_code           String
  students_count        Int       @default(0)
  observations          String?
  old_id                String?
  fake                  Boolean   @default(false)
  active                Boolean   @default(true)
  delete                Boolean   @default(false)
  seller_id             String
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  seller       Seller        @relation(fields: [seller_id], references: [id], onDelete: Restrict)
  scholarships Scholarship[]
  managers     User[]        @relation("InstitutionManagerUsers")

  @@index([seller_id])
}

model CourseCategory {
  id         String   @id @default(cuid())
  name       String
  old_id     String?
  order      Int?
  active     Boolean  @default(true)
  delete     Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  courses Course[]
}

model Course {
  id            String       @id @default(cuid())
  name          String
  duration      Int
  duration_type DurationType
  category_id   String
  old_id        String?
  active        Boolean      @default(true)
  delete        Boolean      @default(false)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  category     CourseCategory @relation(fields: [category_id], references: [id], onDelete: Restrict)
  scholarships Scholarship[]

  @@index([category_id])
}

model Scholarship {
  id                         String          @id @default(cuid())
  shift                      String
  type                       ScholarshipType
  full_price                 Decimal         @db.Decimal(12, 2)
  discount                   Decimal         @db.Decimal(12, 2)
  final_price                Decimal         @db.Decimal(12, 2)
  is_yearly                  Boolean         @default(false)
  registration_fee           Decimal?        @db.Decimal(12, 2)
  adhesion_fee               Decimal?        @db.Decimal(12, 2)
  registration_fee_discount  Decimal?        @db.Decimal(12, 2)
  installments               Int?
  quantity_offered           Int
  renovation_days            Int
  register_period_start      DateTime
  register_period_end        DateTime?
  course_description         String          @db.Text
  period                     String?
  liberado_por_qtd_indicacao Int?
  expired                    Boolean         @default(false)
  course_id                  String
  institution_id             String
  old_id                     String?
  active                     Boolean         @default(true)
  delete                     Boolean         @default(false)
  created_at                 DateTime        @default(now())
  updated_at                 DateTime        @updatedAt

  course          Course           @relation(fields: [course_id], references: [id], onDelete: Restrict)
  institution     Institution      @relation(fields: [institution_id], references: [id], onDelete: Restrict)
  payments        Payment[]
  orders          Order[]
  signedContracts SignedContract[]
  registeredUsers User[]           @relation("UserRegisterScholarship")

  @@index([course_id])
  @@index([institution_id])
}

model Order {
  id             String   @id @default(cuid())
  user_id        String
  scholarship_id String
  expired        Boolean  @default(false)
  is_renew       Boolean  @default(false)
  defaulter      Boolean  @default(false)
  code           Int      @unique
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user        User        @relation(fields: [user_id], references: [id], onDelete: Restrict)
  scholarship Scholarship @relation(fields: [scholarship_id], references: [id], onDelete: Restrict)
  payments    Payment[]

  @@index([user_id])
  @@index([scholarship_id])
}

model Payment {
  id                 String       @id @default(cuid())
  user_id            String
  scholarship_id     String
  order_id           String
  gateway_order_id   String?
  gateway_payment_id String?
  status             String
  payment_type       PaymentType?
  code_boleto        String?
  url_boleto         String?
  boleto_expire_date DateTime?
  full_price         Decimal      @db.Decimal(12, 2)
  final_price        Decimal      @db.Decimal(12, 2)
  discount           Decimal      @db.Decimal(12, 2)
  installment_count  Int?
  own_code           String
  renew              Boolean      @default(false)
  delete             Boolean      @default(false)
  active             Boolean      @default(true)
  date_paid          DateTime?
  percent            Int?
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  user        User        @relation(fields: [user_id], references: [id], onDelete: Restrict)
  scholarship Scholarship @relation(fields: [scholarship_id], references: [id], onDelete: Restrict)
  order       Order       @relation(fields: [order_id], references: [id], onDelete: Restrict)

  @@index([user_id])
  @@index([scholarship_id])
  @@index([order_id])
}

model SignedContract {
  id             String   @id @default(cuid())
  ip             String
  isMobile       Boolean?
  user_id        String
  scholarship_id String
  deviceInfo     String
  delete         Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user        User        @relation(fields: [user_id], references: [id], onDelete: Restrict)
  scholarship Scholarship @relation(fields: [scholarship_id], references: [id], onDelete: Restrict)

  @@index([user_id])
  @@index([scholarship_id])
}

model Indication {
  id         String   @id @default(cuid())
  user_id    String
  name       String
  email      String
  cell       String
  city       String
  delete     Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user  User             @relation(fields: [user_id], references: [id], onDelete: Restrict)
  calls IndicationCall[] @relation("IndicationCalls")

  @@unique([email, cell])
  @@index([user_id])
}

model IndicationCall {
  id            String   @id @default(cuid())
  indication_id String
  caller_id     String
  receiver_id   String?
  description   String
  to_return     Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  indication Indication @relation("IndicationCalls", fields: [indication_id], references: [id], onDelete: Restrict)
  caller     User       @relation("IndicationCaller", fields: [caller_id], references: [id], onDelete: Restrict)
  receiver   User?      @relation("IndicationReceiver", fields: [receiver_id], references: [id], onDelete: SetNull)

  @@index([indication_id])
  @@index([caller_id])
  @@index([receiver_id])
}

model Minor {
  id         String   @id @default(cuid())
  user_id    String
  name       String
  birthdate  DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id])
}

model PossiblePartner {
  id              String   @id @default(cuid())
  institutionName String?
  cnpj            String?
  modality        String?
  name            String
  email           String
  message         String?  @db.Text
  cell            String
  city            String?
  numStudents     String?
  delete          Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  calls PossiblePartnerCall[]
}

model PossiblePartnerCall {
  id                  String   @id @default(cuid())
  possible_partner_id String
  caller_id           String
  receiver_id         String?
  description         String
  to_return           Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  possiblePartner PossiblePartner @relation(fields: [possible_partner_id], references: [id], onDelete: Restrict)
  caller          User            @relation("PossiblePartnerCaller", fields: [caller_id], references: [id], onDelete: Restrict)
  receiver        User?           @relation("PossiblePartnerReceiver", fields: [receiver_id], references: [id], onDelete: SetNull)

  @@index([possible_partner_id])
  @@index([caller_id])
  @@index([receiver_id])
}

model Call {
  id          String   @id @default(cuid())
  caller_id   String
  receiver_id String?
  description String
  to_return   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  caller   User  @relation("UserCallsMade", fields: [caller_id], references: [id], onDelete: Restrict)
  receiver User? @relation("UserCallsReceived", fields: [receiver_id], references: [id], onDelete: SetNull)

  @@index([caller_id])
  @@index([receiver_id])
}

model Notification {
  id         String   @id @default(cuid())
  title      String
  message    String   @db.Text
  read       Boolean  @default(false)
  user_id    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id])
}

model Faq {
  id         String   @id @default(cuid())
  question   String
  answer     String   @db.Text
  delete     Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ExternalClient {
  id                String     @id
  name              String
  personType        PersonType
  externalReference String     @unique
  cpfCnpj           String
  birthDate         DateTime
  phone             String
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  user User @relation(fields: [externalReference], references: [id], onDelete: Restrict)

  @@index([externalReference])
}
