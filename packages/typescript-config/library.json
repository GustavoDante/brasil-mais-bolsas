{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Library (CJS + .d.ts)",
  "extends": "./base.json",

  // Pacotes de `packages/*` emitem CommonJS: o Nest compila para CJS e não consegue
  // `require` um pacote ESM puro. O Next consome CJS sem atrito.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
